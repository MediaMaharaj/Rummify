{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/join/:sessionId", "destination": "/join" }
  ],
  "headers": [
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ]
}
